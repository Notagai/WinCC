<Application x:Class="WinCC.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#EDF2FF" />
      <Setter Property="Background" Value="#20283B" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Background" Value="#CED8F4" />
      <Setter Property="Foreground" Value="#172033" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#182133" />
      <Setter Property="Foreground" Value="#EDF2FF" />
      <Setter Property="CaretBrush" Value="White" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="3" /><Setter Property="MinWidth" Value="100" /></Style>
  </Application.Resources>
</Application>
